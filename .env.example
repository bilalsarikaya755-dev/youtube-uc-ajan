# Anahtarları kendi bilgisayarındaki .env dosyasına ekle.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 4 Ekim 2026 resmi model kataloglarına göre örnekler.
# Hesabında erişilebilirliği kontrol et; istersen model kimliklerini değiştir.
RESEARCH_MODEL=openai/gpt-6.1-sol
WRITER_MODEL=anthropic/claude-sonnet-5-5
DIRECTOR_MODEL=gemini/gemini-3.8-flash

# CrewAI telemetrisi bu proje için kapalı.
CREWAI_TELEMETRY_DISABLED=true
OTEL_SDK_DISABLED=true
